generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String    @id @default(cuid())
  name         String
  color        String    @default("#1E3A8A")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  comments     Comment[]
  ownedTodos   Todo[]    @relation("OwnedTodos")
  createdTodos Todo[]    @relation("CreatedTodos")
}

model Todo {
  id              String    @id @default(cuid())
  title           String
  description     String?
  status          Status    @default(TODO)
  priority        Priority  @default(MEDIUM)
  dueDate         DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  listOwnerId     String    // Whose list this belongs to
  createdById     String    // Who created this task
  assignedUserIds String[]  @default([]) // Users assigned to work on this task
  parentId        String?
  comments        Comment[]
  parent          Todo?     @relation("SubTodos", fields: [parentId], references: [id], onDelete: Cascade)
  subTodos        Todo[]    @relation("SubTodos")
  listOwner       User      @relation("OwnedTodos", fields: [listOwnerId], references: [id], onDelete: Cascade)
  creator         User      @relation("CreatedTodos", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([listOwnerId])
  @@index([createdById])
  @@index([status])
  @@index([parentId])
}

model Comment {
  id        String   @id @default(cuid())
  text      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  todoId    String
  userId    String
  todo      Todo     @relation(fields: [todoId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@index([userId])
}

enum Status {
  TODO
  IN_PROGRESS
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}
